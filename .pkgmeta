package-as: Syncline

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

# No libraries and no externals: building a release downloads nothing.

# CurseForge relations, sent with every release (CurseForge project slugs).
# No comments behind the slugs: the packager sends them along as part of the name.
# restedxp-guide = RestedXP Guides, whose guides Syncline syncs
required-dependencies:
  - restedxp-guide

ignore:
  - README.md
  - tests
  - docs
  - .gitignore
  - tools
  - media/icon-400.png
