package-as: Syncline

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

# No libraries and no externals: building a release downloads nothing.

# CurseForge relations, sent with every release (CurseForge project slugs).
required-dependencies:
  - restedxp-guide      # RestedXP Guides: Syncline syncs its guides

ignore:
  - README.md
  - tests
  - docs
  - .gitignore
  - tools
  - media/icon-400.png
