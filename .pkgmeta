package-as: Syncline

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

# No libraries and no externals: building a release downloads nothing.

required-dependencies:
  - rxp-guides          # RestedXP Guides (CurseForge slug, bitte prüfen)

ignore:
  - README.md
  - tests
  - docs
  - .gitignore
  - tools
  - media/icon-400.png
